PORT=5000
ASSEMBLYAI_API_KEY=

# Path to the local Git repository DebugSignal should investigate.
# Can be absolute or relative to server/src/.
# If absent, the demo-repository in the workspace root is used automatically.
#
# Examples:
#   REPOSITORY_PATH=../demo-repository
#   REPOSITORY_PATH=C:/Users/you/projects/my-app
#   REPOSITORY_PATH=/home/you/projects/my-app
REPOSITORY_PATH=../demo-repository